# Copy to .env and fill in. Never commit .env.

# --- Database (given ONLY to the db and broker containers) ---
POSTGRES_DB=governance
POSTGRES_USER=broker
POSTGRES_PASSWORD=change-me-db-password

# --- Broker ---
# Signs agent tokens. Only the broker holds it. >= 16 chars.
BROKER_SIGNING_SECRET=change-me-long-random-signing-secret
TOKEN_TTL_SECONDS=900
# The agent's client credential, used to obtain short-lived tokens from the broker.
AGENT_CLIENT_SECRET=change-me-agent-client-secret
# Client credential for the team orchestrator (multi-agent mode). Sub-agents have none:
# they can only act via tokens the broker mints at handoff.
ORCHESTRATOR_CLIENT_SECRET=change-me-orchestrator-client-secret

# --- LLM (agent only) ---
# Local (default): a host Ollama server with a tool-calling model, e.g. `ollama pull gemma4:e4b`.
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
# Optional cheaper model for team specialists (they only fetch data and report back)
LLM_SUBAGENT_MODEL=
# OpenAI reasoning effort: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_REASONING=true
# Hosted alternative: set LLM_PROVIDER=anthropic (or openai), a key, and optionally LLM_MODEL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
